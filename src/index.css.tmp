@font-face {
  font-family: 'LINE Seed Sans TH';
  src: url('/assets/fonts/LINESeedSansTH_W_Rg.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'LINE Seed Sans TH';
  src: url('/assets/fonts/LINESeedSansTH_W_Bd.woff2') format('woff2');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'LINE Seed Sans TH';
  src: url('/assets/fonts/LINESeedSansTH_W_XBd.woff2') format('woff2');
  font-weight: 800;
  font-style: normal;
  font-display: swap;
}

html { scroll-behavior: smooth; }
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'LINE Seed Sans TH', sans-serif; }
body { background: #f8effb; color: #5b4571; overflow-x: hidden; }
header { position: fixed; width: 100%; top: 0; left: 0; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 4px 20px rgba(118, 85, 142, 0.1); display: flex; align-items: center; gap: 32px; padding: 5px 4%; min-height: 60px; z-index: 1000; transition: all 0.3s; }
.logo { width: auto; height: 45px; object-fit: contain; transition: all 0.3s; }
nav { display: flex; justify-content: center; gap: 34px; flex: 1; }
nav a { font-family: 'Outfit', sans-serif; color: #7765a5; text-decoration: none; font-weight: 800; padding: 15px 0 10px; transition: all 0.3s; }
nav .active { color: #ed589a; border-bottom: 3px solid #ed589a; }
.count { font-family: 'Outfit', sans-serif; background: #f25498; color: #fff; padding: 10px 18px; border-radius: 28px; font-weight: 800; white-space: nowrap; transition: all 0.3s; }
.menu-btn { display: none; background: none; border: none; font-size: 32px; color: #f25498; cursor: pointer; padding: 0; }

main { max-width: 1340px; margin: 60px auto 40px; padding: 0 18px; }
#wish, #wall { scroll-margin-top: 90px; }
.panel { background: #fff; border-radius: 28px; padding: 32px; margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 42px; box-shadow: 0 10px 35px #76558e1a; }
h2 { margin: 0; color: #7562a4; font-size: 26px; }
.sub { margin: 5px 0 24px; color: #9585ae; }
.step { margin: 18px 0; }
.stepTitle { font-weight: 800; margin-bottom: 9px; }
.colors { display: flex; gap: 12px; }
.color { width: 58px; height: 58px; border-radius: 10px; border: 2px solid transparent; cursor: pointer; appearance: none; -webkit-appearance: none; padding: 0; }
.selected { border-color: #ef5a9d !important; box-shadow: 0 0 0 4px #fde2ee; }
.c1 { background: #f8b4cf; }
.c2 { background: #cbdff8; }
.c3 { background: #dcccf3; }
.c4 { background: #f7dcae; }
.c5 { background: #f6cee2; }
input, textarea { width: 100%; border: 1px solid #e5dceb; border-radius: 12px; padding: 13px; font: inherit; color: #66558f; }
textarea { height: 125px; resize: vertical; }
.upload { border: 2px dashed #ded3e8; border-radius: 14px; padding: 24px; text-align: center; display: block; cursor: pointer; }
.buttons { display: flex; gap: 12px; margin-top: 18px; }
.action { flex: 1; border: 0; border-radius: 28px; padding: 14px; font: inherit; font-weight: 800; cursor: pointer; }
.send { background: #f25498; color: #fff; }
.preview { background: #fff; color: #7662a3; border: 1px solid #ded3e8; }

.cardTitle { text-align: center; font-weight: 800; margin-bottom: 12px; }
.card { min-height: 570px; border-radius: 22px; padding: 30px 25px; text-align: center; background: linear-gradient(160deg, #ffd9ea, #f7dff5, #e9dcff); border: 2px solid #f0b7d6; }
.card img { width: 230px; height: auto; object-fit: contain; }
.cardName { font-size: 27px; color: #f05499; font-weight: 800; margin: 15px; }
.cardMsg { white-space: pre-line; line-height: 1.9; font-size: 17px; margin: 24px auto; max-width: 400px; }

.wallTitle { text-align: center; margin: 60px 0 24px; }
.wall { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.empty-wall { display: flex; justify-content: center; align-items: center; min-height: 240px; background: #fff; border: 1px dashed #e4d8eb; border-radius: 18px; }
.empty-message { text-align: center; color: #917eae; padding: 35px 20px; }
.empty-heart { color: #f05b9f; font-size: 48px; line-height: 1; margin-bottom: 8px; }
.empty-message h3 { margin: 0 0 6px; color: #7562a4; font-size: 20px; }
.empty-message p { margin: 0; line-height: 1.8; }
  padding: 12px; /* Outer border thickness */
  border-radius: 6px; 
  min-height: 220px; 
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.wish-inner {
  background: #fffdf8; /* Cream inner background */
  padding: 20px;
  flex: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;

  /* Corrected Stamp Edge Mask */
  --r: 6px; /* Hole radius */
  -webkit-mask: 
    radial-gradient(circle at 0 0, transparent var(--r), black calc(var(--r) + 0.5px)) 0 0 / 51% 51% no-repeat,
    radial-gradient(circle at 100% 0, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 0 / 51% 51% no-repeat,
    radial-gradient(circle at 0 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 0 100% / 51% 51% no-repeat,
    radial-gradient(circle at 100% 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 100% / 51% 51% no-repeat,
    linear-gradient(black 0 0) 50% 50% / calc(100% - 2*var(--r)) calc(100% - 2*var(--r)) no-repeat,
    radial-gradient(circle at 50% 0, transparent var(--r), black calc(var(--r) + 0.5px)) 50% 0 / 24px 100% repeat-x,
    radial-gradient(circle at 50% 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 50% 100% / 24px 100% repeat-x,
    radial-gradient(circle at 0 50%, transparent var(--r), black calc(var(--r) + 0.5px)) 0 50% / 100% 24px repeat-y,
    radial-gradient(circle at 100% 50%, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 50% / 100% 24px repeat-y;
  mask: 
    radial-gradient(circle at 0 0, transparent var(--r), black calc(var(--r) + 0.5px)) 0 0 / 51% 51% no-repeat,
    radial-gradient(circle at 100% 0, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 0 / 51% 51% no-repeat,
    radial-gradient(circle at 0 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 0 100% / 51% 51% no-repeat,
    radial-gradient(circle at 100% 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 100% / 51% 51% no-repeat,
    linear-gradient(black 0 0) 50% 50% / calc(100% - 2*var(--r)) calc(100% - 2*var(--r)) no-repeat,
    radial-gradient(circle at 50% 0, transparent var(--r), black calc(var(--r) + 0.5px)) 50% 0 / 24px 100% repeat-x,
    radial-gradient(circle at 50% 100%, transparent var(--r), black calc(var(--r) + 0.5px)) 50% 100% / 24px 100% repeat-x,
    radial-gradient(circle at 0 50%, transparent var(--r), black calc(var(--r) + 0.5px)) 0 50% / 100% 24px repeat-y,
    radial-gradient(circle at 100% 50%, transparent var(--r), black calc(var(--r) + 0.5px)) 100% 50% / 100% 24px repeat-y;
}
.w1 { background: #ffdeee; }
.w2 { background: #dfecff; }
.w3 { background: #e9defd; }
.w4 { background: #ffecd6; }

.hero-section {
  width: 100%;
  height: calc(100vh - 60px);
  margin-top: 60px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #f2a2c1 0%, #eaf6fa 100%);
}
.hero-main {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}
.hero-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120px;
  background: linear-gradient(to bottom, rgba(248,237,251,0) 0%, rgba(248,237,251,0.25) 40%, rgba(248,237,251,0.75) 75%, #f8effb 100%);
  pointer-events: none;
  z-index: 2;
}

/* Marquee Styling */
.marquee-strip {
  display: none;
  width: 100%;
  overflow: hidden;
  background: #89c7eb;
  color: white;
  padding: 12px 0;
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
  font-size: 16px;
  letter-spacing: 2px;
  border-top: 2px solid #6eb3d8;
  border-bottom: 2px solid #6eb3d8;
}
.marquee-track {
  display: inline-block;
  white-space: nowrap;
  animation: scrollMarquee 80s linear infinite;
}
.marquee-track span {
  display: inline-block;
}
@keyframes scrollMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}
.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

@media(max-width:900px) {
  /* Show Marquee on Mobile, hide fade */
  .marquee-strip {
    display: block;
  }
  .hero-fade {
    display: none;
  }
  header { height: auto; flex-wrap: wrap; justify-content: space-between; padding: 10px 15px; }
  header.shrink { padding: 5px 15px; }
  header.shrink .logo { height: 40px; }
  .menu-btn { display: block; order: 2; margin-left: auto; }
  .count { order: 1; margin-left: 10px; }
  nav { position: absolute; top: calc(100% + 5px); right: 15px; left: auto; width: auto; min-width: 160px; z-index: 99; display: none; flex-direction: column; background: #fff; border-radius: 12px; box-shadow: 0 8px 25px rgba(118,85,142,0.15); padding: 6px; gap: 0; }
  nav.show { display: flex; }
  nav a { padding: 12px 18px; border-bottom: 1px solid #f8effb; text-align: center; font-size: 14px; white-space: nowrap; }
  nav a:last-child { border-bottom: none; }
  nav .active { border-bottom: none; color: #ed589a; background: #fdf2f7; border-radius: 8px; }
  .panel { grid-template-columns: 1fr; padding: 22px 16px; }
  .wall { grid-template-columns: 1fr 1fr; }
  .hero-section { min-height: calc(100vh - 150px); min-height: calc(100svh - 120px); height: auto; margin-top: 75px; display: flex; flex-direction: column; justify-content: flex-start; }
  .hero-main { height: auto; display: flex; align-items: flex-start; justify-content: center; }
  .hero-main img { height: auto; width: 100%; max-height: calc(100vh - 150px); max-height: calc(100svh - 120px); object-fit: contain; }
}

@media(max-width:560px) {
  .wall { grid-template-columns: 1fr; }
  .buttons { flex-direction: column; }
  .logo { width: 130px; height: 55px; }
  header { gap: 8px; }
  .count { padding: 10px 15px; font-size: 13px; }
  .color { width: 46px; height: 46px; }
}


/* FOOTER */
.footer-section {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  margin: 0;
}
.footer-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 25px;
}
.footer-image-container {
  width: 100%;
  position: relative;
  background: #fcf9f5; /* Light cream, almost white */
  display: flex;
  justify-content: flex-end; /* Align image to the right */
  align-items: stretch;
  overflow: hidden;
}
.footer-image {
  height: 300px; /* Locked height to the sweet spot */
  width: auto; /* Width scales proportionally */
  max-width: 100%;
  display: block;
  object-fit: contain; /* Guarantee full image is visible without cropping */
  /* Fade out only the left edge of the image quickly */
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%);
  mask-image: linear-gradient(to right, transparent 0%, black 15%);
}
.footer-overlay-text {
  position: absolute;
  top: 50%;
  left: 8%;
  transform: translateY(-50%);
  width: 45%;
  text-align: left;
  z-index: 10;
}
.footer-title {
  font-family: 'LINE Seed Sans TH', sans-serif;
  font-size: 2.0rem; /* Between 1.8rem and 2.2rem */
  font-weight: 700;
  color: #f25498;
  line-height: 1.6; /* Increased line spacing */
  margin: 0;
}
@media (max-width: 600px) {
  .footer-image-container {
    height: auto; /* Let the container wrap the image */
    justify-content: center;
  }
  .footer-image {
    width: 100%; /* Full width image */
    height: auto;
    /* Remove fade effect on mobile */
    -webkit-mask-image: none;
    mask-image: none;
  }
  .footer-overlay-text {
    top: auto;
    bottom: 8%; /* Center bottom */
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    text-align: center;
  }
  .footer-title {
    font-size: 0.65rem;
    /* Soft white outer stroke */
    -webkit-text-stroke: 1px #fff;
    paint-order: stroke fill;
    /* Soft, faded glowing effect */
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.9), 0 0 8px rgba(255, 255, 255, 0.6);
  }
}
/* NEW POSTCARD DESIGN CSS */
.wish-inner { position: relative; overflow: hidden; }

.corner-dot {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--bg-color);
}
.corner-dot.top-left { top: 12px; left: 12px; }
.corner-dot.top-right { top: 12px; right: 12px; }
.corner-dot.bottom-left { bottom: 12px; left: 12px; }
.corner-dot.bottom-right { bottom: 12px; right: 12px; }

.bow-icon {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 24px;
  z-index: 5;
  transform: rotate(15deg);
}

.wish-content {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
  flex: 1; 
  padding-bottom: 40px; /* Space for banner */
}
.wish-content.has-img {
  flex-direction: row;
  align-items: flex-start;
}
.wish-text-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.wish-img-col {
  width: 45%;
  flex-shrink: 0;
  display: flex;
}
.wish-img-col img {
  width: 100%;
  height: auto;
  border-radius: 0 !important; /* Square corners */
}

.name-ribbon {
  background: var(--bg-color);
  color: #fff;
  padding: 6px 16px;
  display: inline-block;
  position: relative;
  -webkit-mask: radial-gradient(circle at 0 50%, transparent 5px, black 6px) 0 0/51% 100% no-repeat,
                radial-gradient(circle at 100% 50%, transparent 5px, black 6px) 100% 0/51% 100% no-repeat;
  mask: radial-gradient(circle at 0 50%, transparent 5px, black 6px) 0 0/51% 100% no-repeat,
        radial-gradient(circle at 100% 50%, transparent 5px, black 6px) 100% 0/51% 100% no-repeat;
  margin-left: 10px;
}
.name-ribbon-inner {
  border: 1.5px dashed #fff;
  padding: 4px 15px;
  border-radius: 2px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 13px;
}

.wish-msg {
  color: #ed589a;
  font-weight: 600;
  margin-top: 15px;
  padding-left: 10px;
  line-height: 1.6;
}

.to-cartoon-banner {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: var(--bg-color);
  color: #fff;
  padding: 4px 12px;
  font-weight: 800;
  letter-spacing: 1px;
  transform: rotate(-4deg);
  font-size: 11px;
  z-index: 2;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.05); 
}

/* WISH MODAL SYSTEM */
.wish-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.wish-modal-content {
  position: relative;
  max-width: 600px;
  width: 100%;
  animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.wish-modal-close {
  position: absolute;
  top: -15px;
  right: -15px;
  background: #fff;
  color: #333;
  width: 35px; height: 35px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  z-index: 10;
  border: none;
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

/* CLAMP TEXT ON WALL ONLY (NOT IN MODAL OR FORM) */
.wall .wish-msg {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Add hover effect to clickable cards */
.wish-card-wrapper {
  transition: transform 0.2s;
}
.wish-card-wrapper:hover {
  transform: translateY(-5px);
}
